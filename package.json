{
  "name": "cm-packer",
  "version": "1.1.3-rc.2",
  "description": "Command-line tool for packing and unpacking IMSCC files (Common Cartridge 1.4)",
  "main": "dist/index.js",
  "homepage": "https://videlais.github.io/cm-packer/",
  "repository": {
    "type": "git",
    "url": "https://github.com/videlais/cm-packer.git"
  },
  "bin": {
    "cm-packer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && tsc -p scripts/tsconfig.json",
    "build:binaries": "tsc -p scripts/tsconfig.json && node scripts/dist/build-binaries.js",
    "build:web": "tsc -p scripts/tsconfig.json && tsc -p tsconfig.web.json && node scripts/dist/build-web.js",
    "audit": "npm audit --audit-level=moderate",
    "test": "npm run build && jest --coverage",
    "test:binary": "node scripts/dist/smoke-test-binary.js",
    "test:web": "npm run build:web && playwright test",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts' --fix",
    "all": "npm run audit && npm run lint && npm run test && npm run build && npm run build:web && npm run test:web"
  },
  "keywords": [
    "imscc",
    "common-cartridge",
    "canvas",
    "lms",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/adm-zip": "^0.5.8",
    "@types/jest": "^30.0.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^25.9.1",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@yao-pkg/pkg": "^6.20.0",
    "c8": "^11.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "http-server": "^14.1.1",
    "jest": "^30.4.2",
    "jszip": "^3.10.1",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "pkg": {
    "outputPath": "release-assets"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "commander": "^15.0.0",
    "xml2js": "^0.6.2"
  }
}
