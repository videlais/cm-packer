{
  "name": "cm-packer",
  "version": "1.0.2",
  "description": "Command-line tool for packing and unpacking IMSCC files (Common Cartridge 1.4)",
  "main": "dist/index.js",
  "bin": {
    "cm-packer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && c8 --reporter=text --reporter=html --reporter=lcov jest --coverage=false",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts --fix",
    "all": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "imscc",
    "common-cartridge",
    "canvas",
    "lms",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/adm-zip": "^0.5.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "nyc": "^17.1.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "commander": "^14.0.2",
    "xml2js": "^0.6.2"
  }
}
